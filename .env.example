# Copie para .env.local e preencha. Nunca commite o .env.local.

# Supabase (Settings > API no painel do projeto). Sem elas o site abre, mas sem login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serviço de demos (workers/demos). A API fica nele e cada demo em <id>.<host>.
# Local: http://demos.localhost:8787 (rode `scripts/demos-dev-vars.sh` e `npm --prefix workers/demos run dev`)
NEXT_PUBLIC_DEMOS_URL=

# Filtro de tom com IA. Desligado enquanto o orçamento for US$ 0.
MODERATION_AI_ENABLED=false

# Endereço público do site, usado nos links de login. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Só para o Supabase local (supabase start): app OAuth do GitHub de teste.
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
