// Serviço de demos da Devsync. Nada aqui é publicado sem pedido explícito.
// Segredos (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, UPLOAD_SIGNING_SECRET,
// SAFE_BROWSING_API_KEY (opcional).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsync-demos",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "DEMOS_HOST": "demos.localhost",
    "SITE_URL": "http://localhost:3000",
    "FRAME_ANCESTORS": "",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "SUPABASE_ANON_KEY": ""
  },
  "r2_buckets": [{ "binding": "DEMOS_BUCKET", "bucket_name": "devsync-demos" }],
  "queues": {
    "producers": [
      { "binding": "ZIP_QUEUE", "queue": "demo-zips" },
      { "binding": "LINK_QUEUE", "queue": "demo-links" }
    ],
    "consumers": [
      { "queue": "demo-zips", "max_batch_size": 1, "max_retries": 3 },
      { "queue": "demo-links", "max_batch_size": 5, "max_retries": 2 }
    ]
  },
  // Checagem diária dos links de demo (06:00 UTC = 03:00 em São Paulo).
  "triggers": { "crons": ["0 6 * * *"] }
}
