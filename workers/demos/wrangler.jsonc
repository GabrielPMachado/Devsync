// Serviço de demos da Devsync. Nada aqui é publicado sem pedido explícito.
// Segredos (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, UPLOAD_SIGNING_SECRET,
// SAFE_BROWSING_API_KEY (opcional).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsync-demos-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "DEMOS_HOST": "demos.localhost",
    "SITE_URL": "http://localhost:3000",
    "FRAME_ANCESTORS": "",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "SUPABASE_ANON_KEY": ""
  },
  "r2_buckets": [{ "binding": "DEMOS_BUCKET", "bucket_name": "devsync-demos" }],
  "queues": {
    "producers": [
      { "binding": "ZIP_QUEUE", "queue": "demo-zips" },
      { "binding": "LINK_QUEUE", "queue": "demo-links" }
    ],
    "consumers": [
      { "queue": "demo-zips", "max_batch_size": 1, "max_retries": 4 },
      { "queue": "demo-links", "max_batch_size": 5, "max_retries": 2 }
    ]
  },
  // Checagem diária dos links de demo (06:00 UTC = 03:00 em São Paulo) e, a cada 15 min, builds parados.
  "triggers": { "crons": ["0 6 * * *", "*/15 * * * *"] },

  // Produção. Publicada pelo workflow .github/workflows/deploy-demos.yml.
  // Bindings e vars não são herdados entre ambientes no Wrangler: por isso repetidos.
  "env": {
    // Plano grátis: endereço workers.dev, cada demo numa pasta (/d/<id>/).
    // O workflow troca SUBDOMINIO_WORKERS pelo subdomínio da conta (variável WORKERS_SUBDOMAIN).
    "production": {
      "name": "devsync-demos",
      "workers_dev": true,
      "vars": {
        "DEMOS_HOST": "devsync-demos.SUBDOMINIO_WORKERS.workers.dev",
        "DEMOS_MODE": "path",
        "SITE_URL": "https://devsync-br.vercel.app",
        "FRAME_ANCESTORS": "https://devsync-br.vercel.app",
        "SUPABASE_URL": "https://ogbkwdyzpzrayeupgtcx.supabase.co",
        // Chave pública (publishable), a mesma do site. Os segredos vão no deploy (--secrets-file).
        "SUPABASE_ANON_KEY": "sb_publishable_OIuu4MTrUeb5SrI6NvOupA_jHsGJvPH"
      },
      "r2_buckets": [{ "binding": "DEMOS_BUCKET", "bucket_name": "devsync-demos" }],
      "queues": {
        "producers": [
          { "binding": "ZIP_QUEUE", "queue": "demo-zips" },
          { "binding": "LINK_QUEUE", "queue": "demo-links" }
        ],
        "consumers": [
          { "queue": "demo-zips", "max_batch_size": 1, "max_retries": 4 },
          { "queue": "demo-links", "max_batch_size": 5, "max_retries": 2 }
        ]
      },
      // 30 chamadas da API por minuto por IP (envio, checagem de link, verificação).
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
      "triggers": { "crons": ["0 6 * * *", "*/15 * * * *"] },
      "observability": { "enabled": true }
    },
    // Domínio próprio: cada demo no seu subdomínio (<id>.<domínio>), origem isolada.
    // O workflow troca DOMINIO_DAS_DEMOS pelo domínio (variável DEMOS_DOMAIN) e usa este ambiente.
    "production-domain": {
      "name": "devsync-demos",
      "workers_dev": false,
      "routes": [
        { "pattern": "DOMINIO_DAS_DEMOS/*", "zone_name": "DOMINIO_DAS_DEMOS" },
        { "pattern": "*.DOMINIO_DAS_DEMOS/*", "zone_name": "DOMINIO_DAS_DEMOS" }
      ],
      "vars": {
        "DEMOS_HOST": "DOMINIO_DAS_DEMOS",
        "DEMOS_MODE": "subdomain",
        "SITE_URL": "https://devsync-br.vercel.app",
        "FRAME_ANCESTORS": "https://devsync-br.vercel.app",
        "SUPABASE_URL": "https://ogbkwdyzpzrayeupgtcx.supabase.co",
        // Chave pública (publishable), a mesma do site. Os segredos vão no deploy (--secrets-file).
        "SUPABASE_ANON_KEY": "sb_publishable_OIuu4MTrUeb5SrI6NvOupA_jHsGJvPH"
      },
      "r2_buckets": [{ "binding": "DEMOS_BUCKET", "bucket_name": "devsync-demos" }],
      "queues": {
        "producers": [
          { "binding": "ZIP_QUEUE", "queue": "demo-zips" },
          { "binding": "LINK_QUEUE", "queue": "demo-links" }
        ],
        "consumers": [
          { "queue": "demo-zips", "max_batch_size": 1, "max_retries": 4 },
          { "queue": "demo-links", "max_batch_size": 5, "max_retries": 2 }
        ]
      },
      // 30 chamadas da API por minuto por IP (envio, checagem de link, verificação).
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
      "triggers": { "crons": ["0 6 * * *", "*/15 * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
